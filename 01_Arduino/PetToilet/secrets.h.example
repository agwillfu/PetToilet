#pragma once
/*
 * 把這個檔案複製成 secrets.h，然後填入你自己的值。
 *
 *     cp secrets.h.example secrets.h
 *
 * secrets.h 已列在 .gitignore，不會被 git 追蹤。
 *
 * ⚠️ 重要：OTA 更新走的是明文 HTTP + 韌體簽章，任何人都可能下載到你的 .bin 檔
 *    並從中讀出這些字串。這些憑證只保護你家的 WiFi 與 Adafruit IO 帳號，
 *    不要在這裡放任何更敏感的東西。
 */

// ---- WiFi ----
#define WIFI_SSID       "你的WiFi名稱"
#define WIFI_PASSWORD   "你的WiFi密碼"

// ---- Adafruit IO ----
// Username：登入 io.adafruit.com 後看網址列 io.adafruit.com/<這一段>
// AIO Key ：進入任一個 Dashboard 頁面，右上角黃色鑰匙圖示「My Key」按鈕
#define AIO_USERNAME    "你的Adafruit_IO_使用者名稱"
#define AIO_KEY         "你的Adafruit_IO_Active_Key"

// ---- ArduinoOTA 無線更新密碼 ----
// 之後用 arduino-cli 或 Arduino IDE 從區網無線燒錄時要輸入這組密碼。
// 自己取一組，跟上面的都不一樣。
#define OTA_PASSWORD    "自己取一組OTA密碼"
